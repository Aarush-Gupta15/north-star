# ---- Shared / Compose ----
COMPOSE_PROJECT_NAME=north-star

# ---- Postgres ----
POSTGRES_USER=privacy
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=northstar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Backend ----
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# LLM for plain-language explanations (optional; engine degrades gracefully if unset)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
